{
  "name": "clerkeye",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-submission document cross-check for scholarship applications",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib tests eval scripts --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:matcher": "vitest run --config vitest.eval.config.ts eval/matcher.eval.ts",
    "eval:pipeline": "vitest run --config vitest.eval.config.ts eval/pipeline.eval.ts",
    "fixtures:images": "node scripts/generate-fixtures.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "double-metaphone": "^2.0.1",
    "fastest-levenshtein": "^1.0.16",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.9"
}
